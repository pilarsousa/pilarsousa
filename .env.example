# Copy to .env.local for local dev, and set the same var in Vercel
# (Settings → Environment Variables) for production.

# Go High Level inbound-webhook URL that /api/register forwards leads to.
# Create it in GHL: Automation → Workflows → new workflow → trigger
# "Inbound Webhook" → copy the webhook URL it generates.
GHL_WEBHOOK_URL=

# Optional dedicated Go High Level inbound-webhook URL for /api/diagnostico.
# If unset, /api/diagnostico falls back to GHL_WEBHOOK_URL.
GHL_DIAGNOSTICO_WEBHOOK_URL=

# Supabase — used server-side by /api/game-quiz to store the quiz submissions.
# Use SUPABASE_SERVICE_ROLE_KEY in Vercel so the server route can read/write
# protected tables. If you only set SUPABASE_ANON_KEY, RLS policies/RPC must allow
# the game operations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Sierra Launch Kit — panel de sierra labs (visitas, registros y compras en
# vivo durante los lanzamientos). Cargar en Vercel en Production y Preview.
# SIERRA_INGEST_SECRET es sólo de servidor: nunca con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SIERRA_URL=https://app.laureanosierra.com
NEXT_PUBLIC_SIERRA_SITE_KEY=
SIERRA_INGEST_SECRET=

# GoHighLevel por API (v2) — landings con integración propia (hoy /registro,
# el Seminario de Neurometafísica): crea el contacto y le pone su etiqueta.
# Las demás landings siguen por GHL_WEBHOOK_URL. Si faltan estas dos, /registro
# también vuelve al webhook. Sólo servidor: nunca con prefijo NEXT_PUBLIC_.
# GHL_API_KEY: Private Integration Token de la subcuenta (permiso "Edit Contacts").
# GHL_LOCATION_ID: ID de la subcuenta (Configuración → Perfil de la empresa).
GHL_API_KEY=
GHL_LOCATION_ID=
