# Copy to .env.local for local dev, and set the same var in Vercel
# (Settings → Environment Variables) for production.

# Go High Level inbound-webhook URL that /api/register forwards leads to.
# Create it in GHL: Automation → Workflows → new workflow → trigger
# "Inbound Webhook" → copy the webhook URL it generates.
GHL_WEBHOOK_URL=

# Supabase — used server-side by /api/game-quiz to store the quiz submissions.
# Both are in Supabase → Project Settings → API. The URL is the "Project URL"
# and the key is the "anon / public" key (safe to use with RLS enabled).
SUPABASE_URL=
SUPABASE_ANON_KEY=
